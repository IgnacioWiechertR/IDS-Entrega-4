<div id="<%= dom_id user %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">University:</strong>
    <%= user.university_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Email:</strong>
    <%= user.email %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Rut:</strong>
    <%= user.rut %>
  </div>
  <div>
    <strong class="block font-medium mb-1">First name:</strong>
    <%= user.first_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Last name:</strong>
    <%= user.last_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Active:</strong>
    <%= user.active? ? "Yes" : "No" %>
  </div>
</div>
