<div id="<%= dom_id enrollment %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Section:</strong>
    <%= enrollment.section_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Student:</strong>
    <%= enrollment.student_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Active:</strong>
    <%= enrollment.active? ? "Yes" : "No" %>
  </div>
</div>
