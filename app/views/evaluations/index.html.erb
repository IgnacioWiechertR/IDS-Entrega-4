<% content_for :title, "Evaluaciones · SGA" %>

<section class="py-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-sm font-semibold text-indigo-600">
        <%= @section.course.code %> · Sección <%= @section.number %> · <%= @section.term.name %>
      </p>
      <h1 class="text-2xl font-bold text-slate-900">Evaluaciones de <%= @section.course.name %></h1>
    </div>
    <%= link_to "Nueva evaluación", new_section_evaluation_path(@section), class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
  </div>

  <p id="weight_total" class="mt-4 text-sm text-slate-600">
    Ponderación asignada: <strong><%= weight_percentage(assigned_weight(@section)) %> de 100 %</strong>
  </p>

  <% if @evaluations.any? %>
    <div class="mt-4 overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-slate-600">
          <tr>
            <th class="px-4 py-2 font-semibold">Nombre</th>
            <th class="px-4 py-2 font-semibold">Ponderación</th>
            <th class="px-4 py-2 font-semibold">Fecha</th>
            <th class="px-4 py-2 font-semibold">Pauta</th>
          </tr>
        </thead>
        <tbody id="evaluations" class="divide-y divide-slate-100">
          <% @evaluations.each do |evaluation| %>
            <tr id="<%= dom_id evaluation %>">
              <td class="px-4 py-2 font-medium text-slate-900"><%= evaluation.name %></td>
              <td class="px-4 py-2"><%= weight_percentage(evaluation.weight) %></td>
              <td class="px-4 py-2"><%= l(evaluation.due_on) %></td>
              <td class="px-4 py-2 text-slate-600"><%= evaluation.rubric.present? ? "Sí" : "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-4 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      Todavía no hay evaluaciones en esta sección.
    </p>
  <% end %>

  <div class="mt-6">
    <%= link_to "Volver a la sección", course_section_path(@section.course, @section), class: "text-sm text-indigo-700 hover:underline" %>
  </div>
</section>
