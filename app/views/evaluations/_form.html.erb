<%= form_with model: [ @section, evaluation ], class: "mt-6 space-y-4" do |form| %>
  <% if evaluation.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <p class="font-semibold">No se pudo guardar la evaluación:</p>
      <ul class="mt-1 list-disc pl-5">
        <% evaluation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :name, required: true, placeholder: "Control 1", class: ApplicationHelper::INPUT_CLASSES %>
  </div>

  <div>
    <%= form.label :weight, "Ponderación (%)", class: "block text-sm font-medium text-slate-700" %>
    <%= form.number_field :weight, required: true, step: 0.01, min: 0.01, max: 100, class: ApplicationHelper::INPUT_CLASSES %>
  </div>

  <div>
    <%= form.label :due_on, class: "block text-sm font-medium text-slate-700" %>
    <%= form.date_field :due_on, required: true, class: ApplicationHelper::INPUT_CLASSES %>
  </div>

  <div>
    <%= form.label :rubric, "Pauta (opcional)", class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_area :rubric, rows: 4, class: ApplicationHelper::INPUT_CLASSES %>
  </div>

  <div class="flex items-center gap-4">
    <%= form.submit "Crear evaluación", class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
    <%= link_to "Cancelar", section_evaluations_path(@section), class: "text-sm text-slate-600 hover:underline" %>
  </div>
<% end %>
