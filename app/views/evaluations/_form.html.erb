<%= form_with(model: evaluation, class: "contents") do |form| %>
  <% if evaluation.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(evaluation.errors.count, "error") %> prohibited this evaluation from being saved:</h2>

      <ul class="list-disc ml-6">
        <% evaluation.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :section_id %>
    <%= form.text_field :section_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": evaluation.errors[:section_id].none?, "border-red-400 focus:outline-red-600": evaluation.errors[:section_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": evaluation.errors[:name].none?, "border-red-400 focus:outline-red-600": evaluation.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :weight %>
    <%= form.text_field :weight, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": evaluation.errors[:weight].none?, "border-red-400 focus:outline-red-600": evaluation.errors[:weight].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :due_on %>
    <%= form.date_field :due_on, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": evaluation.errors[:due_on].none?, "border-red-400 focus:outline-red-600": evaluation.errors[:due_on].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :rubric %>
    <%= form.textarea :rubric, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": evaluation.errors[:rubric].none?, "border-red-400 focus:outline-red-600": evaluation.errors[:rubric].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
