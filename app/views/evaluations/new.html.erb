<% content_for :title, "Nueva evaluación · SGA" %>

<section class="mx-auto max-w-xl py-8">
  <p class="text-sm font-semibold text-indigo-600">
    <%= @section.course.code %> · Sección <%= @section.number %> · <%= @section.term.name %>
  </p>
  <h1 class="text-2xl font-bold text-slate-900">Nueva evaluación</h1>
  <p id="weight_available" class="mt-2 text-sm text-slate-600">
    Disponible en la sección: <strong><%= weight_percentage(100 - assigned_weight(@section)) %></strong>
  </p>

  <%= render "form", evaluation: @evaluation %>
</section>
