<div id="<%= dom_id evaluation %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Section:</strong>
    <%= evaluation.section_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= evaluation.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Weight:</strong>
    <%= evaluation.weight %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Due on:</strong>
    <%= evaluation.due_on %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Rubric:</strong>
    <%= evaluation.rubric %>
  </div>
</div>
