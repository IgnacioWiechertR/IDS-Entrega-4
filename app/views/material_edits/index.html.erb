<% content_for :title, "Editar material · #{@course.code} · SGA" %>

<section class="py-8">
  <%= link_to "← Volver al curso", course_path(@course), class: "text-sm font-medium text-indigo-700 hover:underline" %>
  <p class="mt-4 text-sm text-indigo-700"><%= @course.university.name %> · <%= @course.code %></p>
  <h1 class="mt-2 text-2xl font-bold text-slate-900">Editar mi material</h1>
  <p class="mt-2 text-slate-600"><%= @course.name %> · Solo puedes editar el material que tú subiste.</p>

  <% if @materials.any? %>
    <ul id="editable_materials" class="mt-6 divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white">
      <% @materials.each do |material| %>
        <li id="<%= dom_id(material, :editable) %>" class="flex flex-wrap items-center justify-between gap-3 px-4 py-4">
          <div class="min-w-0">
            <p class="break-words font-medium text-slate-900"><%= material.title %></p>
            <% if material.file.attached? %><p class="mt-1 break-words text-sm text-slate-600"><%= material.file.filename %></p><% end %>
          </div>
          <%= link_to "Editar", edit_course_material_edit_path(@course, material), class: "text-sm font-semibold text-indigo-700 hover:underline" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p id="editable_materials_empty" class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">Todavía no tienes material propio editable en este curso.</p>
  <% end %>
</section>
