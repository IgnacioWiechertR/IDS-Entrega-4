<% content_for :title, "Editar material · #{@course.code} · SGA" %>

<section class="mx-auto max-w-2xl py-8">
  <%= link_to "← Mi material del curso", course_material_edits_path(@course), class: "text-sm font-medium text-indigo-700 hover:underline" %>
  <p class="mt-4 text-sm text-indigo-700"><%= @course.university.name %> · <%= @course.code %></p>
  <h1 class="mt-2 text-2xl font-bold text-slate-900">Editar material</h1>
  <p class="mt-2 text-slate-600"><%= @course.name %></p>

  <%= form_with model: @material, url: course_material_edit_path(@course, @material), method: :patch, class: "mt-6 space-y-5" do |form| %>
    <% if @material.errors.any? %>
      <div class="rounded-md border border-red-200 bg-red-50 p-4 text-red-800" role="alert">
        <p class="font-semibold">No se pudo actualizar el material.</p>
        <ul class="mt-2 list-disc pl-5"><% @material.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <div>
      <%= form.label :title, "Título", class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :title, required: true, class: ApplicationHelper::INPUT_CLASSES %>
    </div>

    <div>
      <p id="current_material_file" class="text-sm text-slate-600">
        Archivo actual: <%= @material.file_attachment&.blob&.filename || "Sin archivo" %>
      </p>
      <%= form.label :file, "Reemplazar archivo (opcional)", class: "mt-3 block text-sm font-medium text-slate-700" %>
      <%= form.file_field :file, accept: MaterialFileFormat::ACCEPT_ATTRIBUTE, aria: { describedby: "material_edit_file_help" },
            class: "mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2" %>
      <p id="material_edit_file_help" class="mt-2 text-sm text-slate-600">
        Si no seleccionas otro archivo, se conserva el actual. Máximo 50 MB.
        PDF, Word, Excel, PowerPoint, texto, OpenDocument y documentos de Pages, Numbers o Keynote.
        Para documentos de Google, descarga una copia en uno de estos formatos antes de subirla.
      </p>
      <% if @material.errors.any? %><p class="mt-2 text-sm text-slate-600">Vuelve a seleccionar el archivo si deseas reemplazarlo.</p><% end %>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <%= form.submit "Guardar cambios", class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
      <%= link_to "Cancelar", course_material_edits_path(@course), class: "text-sm font-medium text-indigo-700 hover:underline" %>
    </div>
  <% end %>
</section>
