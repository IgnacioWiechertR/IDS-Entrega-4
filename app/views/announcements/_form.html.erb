<%= form_with(model: announcement, class: "mt-6 space-y-5") do |form| %>
  <%= form.hidden_field :course_id if announcement.new_record? %>

  <% if announcement.errors.any? %>
    <div id="error_explanation" class="rounded-lg bg-red-50 p-4 text-red-800" role="alert">
      <p class="font-semibold">Revisa el anuncio:</p>
      <ul class="mt-2 list-disc pl-5">
        <% announcement.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if announcement.new_record? %>
    <div>
      <%= form.label :section_id, "Destinatarios", class: "block text-sm font-semibold text-slate-700" %>
      <%= form.select :section_id, [[ "Toda la asignatura", "" ]] + sections.map { |section| [ "Sección #{section.number} · #{section.term.name}", section.id ] }, {},
            class: "mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2" %>
    </div>
  <% else %>
    <p class="text-sm text-slate-600">Destinatarios: <%= announcement.section ? "Sección #{announcement.section.number}" : "Toda la asignatura" %></p>
  <% end %>
  <div>
    <%= form.label :subject, "Asunto", class: "block text-sm font-semibold text-slate-700" %>
    <%= form.text_field :subject, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
  </div>
  <div>
    <%= form.label :body, "Mensaje", class: "block text-sm font-semibold text-slate-700" %>
    <%= form.text_area :body, rows: 7, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2" %>
  </div>
  <%= form.submit announcement.new_record? ? "Publicar anuncio" : "Guardar cambios", class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
<% end %>
