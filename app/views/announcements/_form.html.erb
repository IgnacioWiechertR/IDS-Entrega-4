<%= form_with(model: announcement, class: "contents") do |form| %>
  <% if announcement.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(announcement.errors.count, "error") %> prohibited this announcement from being saved:</h2>

      <ul class="list-disc ml-6">
        <% announcement.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :course_id %>
    <%= form.text_field :course_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": announcement.errors[:course_id].none?, "border-red-400 focus:outline-red-600": announcement.errors[:course_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :section_id %>
    <%= form.text_field :section_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": announcement.errors[:section_id].none?, "border-red-400 focus:outline-red-600": announcement.errors[:section_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :subject %>
    <%= form.text_field :subject, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": announcement.errors[:subject].none?, "border-red-400 focus:outline-red-600": announcement.errors[:subject].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :body %>
    <%= form.textarea :body, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": announcement.errors[:body].none?, "border-red-400 focus:outline-red-600": announcement.errors[:body].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :author_id %>
    <%= form.text_field :author_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": announcement.errors[:author_id].none?, "border-red-400 focus:outline-red-600": announcement.errors[:author_id].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
