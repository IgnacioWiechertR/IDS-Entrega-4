<% content_for :title, "#{@announcement.subject} · SGA" %>

<section class="mx-auto max-w-3xl py-8">
  <p class="text-sm"><%= link_to "← Anuncios", announcements_path, class: "text-indigo-700 hover:underline" %></p>
  <p class="mt-6 text-sm font-semibold text-indigo-600"><%= @announcement.course.code %> · <%= @announcement.course.name %></p>
  <h1 class="mt-1 text-2xl font-bold text-slate-900"><%= @announcement.subject %></h1>
  <% if can?(:update, @announcement) %>
    <p class="mt-3"><%= link_to "Editar anuncio", edit_announcement_path(@announcement), class: "text-sm font-medium text-indigo-700 hover:underline" %></p>
  <% end %>

  <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm text-slate-600">
    <div><dt class="inline font-medium">Destino:</dt> <dd class="inline"><%= @announcement.section ? "Sección #{@announcement.section.number}" : "Toda la asignatura" %></dd></div>
    <div><dt class="inline font-medium">Autor:</dt> <dd class="inline"><%= @announcement.author.name %></dd></div>
    <div><dt class="inline font-medium">Publicado:</dt> <dd class="inline"><%= l(@announcement.created_at, format: "%d/%m/%Y %H:%M") %></dd></div>
    <% if @announcement.updated_at > @announcement.created_at %>
      <div><dt class="inline font-medium">Editado:</dt> <dd class="inline"><%= l(@announcement.updated_at, format: "%d/%m/%Y %H:%M") %></dd></div>
    <% end %>
  </dl>

  <div id="announcement_body" class="mt-6 whitespace-pre-wrap rounded-lg border border-slate-200 bg-white p-6 text-slate-900"><%= @announcement.body %></div>

  <% if can?(:destroy, @announcement) %>
    <%= button_to "Eliminar anuncio", @announcement, method: :delete,
          form: { data: { turbo_confirm: "¿Eliminar el anuncio «#{@announcement.subject}»? Esta acción no se puede deshacer." } },
          class: "mt-6 rounded-md bg-red-600 px-4 py-2 font-semibold text-white hover:bg-red-500 cursor-pointer" %>
  <% end %>
</section>
