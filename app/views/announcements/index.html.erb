<% content_for :title, "Anuncios · SGA" %>

<section class="py-8">
  <h1 class="text-2xl font-bold text-slate-900">Anuncios de mis cursos</h1>

  <% if @announcements.any? %>
    <div id="announcements" class="mt-6 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      <% @announcements.each do |announcement| %>
        <article id="<%= dom_id(announcement) %>" class="p-5">
          <p class="text-sm font-semibold text-indigo-600"><%= announcement.course.code %> · <%= announcement.course.name %></p>
          <h2 class="mt-1 text-lg font-semibold">
            <%= link_to announcement.subject, announcement_path(announcement), class: "text-slate-900 hover:text-indigo-700 hover:underline" %>
          </h2>
          <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-slate-600">
            <div><dt class="inline font-medium">Destino:</dt> <dd class="inline"><%= announcement.section ? "Sección #{announcement.section.number}" : "Toda la asignatura" %></dd></div>
            <div><dt class="inline font-medium">Autor:</dt> <dd class="inline"><%= announcement.author.name %></dd></div>
            <div><dt class="inline font-medium">Publicado:</dt> <dd class="inline"><%= l(announcement.created_at, format: "%d/%m/%Y %H:%M") %></dd></div>
            <% if announcement.updated_at > announcement.created_at %>
              <div><dt class="inline font-medium">Editado:</dt> <dd class="inline"><%= l(announcement.updated_at, format: "%d/%m/%Y %H:%M") %></dd></div>
            <% end %>
          </dl>
        </article>
      <% end %>
    </div>
  <% else %>
    <p id="announcements_empty" class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-slate-600">
      Aún no hay anuncios en tus cursos.
    </p>
  <% end %>
</section>
