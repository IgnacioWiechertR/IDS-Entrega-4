<div id="<%= dom_id announcement %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Course:</strong>
    <%= announcement.course_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Section:</strong>
    <%= announcement.section_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Subject:</strong>
    <%= announcement.subject %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Body:</strong>
    <%= announcement.body %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Author:</strong>
    <%= announcement.author_id %>
  </div>
</div>
