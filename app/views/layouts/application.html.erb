<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "SGA" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="SGA">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3">
        <%= link_to "SGA", root_path, class: "text-lg font-bold text-indigo-700" %>

        <% if user_signed_in? %>
          <nav class="flex flex-1 flex-wrap items-center gap-4 text-sm" aria-label="Principal">
            <% if can?(:read, :dashboard) %><%= nav_link_to "Dashboard", dashboard_path %><% end %>
            <% if can?(:index, :accounts) %><%= nav_link_to "Cuentas", accounts_path %><% end %>
            <% if can?(:index, Course) %><%= nav_link_to "Mis cursos", courses_path %><% end %>
          </nav>

          <div class="flex items-center gap-3 text-sm">
            <span class="text-slate-600"><%= current_user.name %> · <%= current_user.role_name %></span>
            <%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete,
                  class: "rounded-md border border-slate-300 px-3 py-1.5 text-slate-700 hover:bg-slate-50" %>
          </div>
        <% else %>
          <%= link_to "Iniciar sesión", new_user_session_path, class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
        <% end %>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4">
      <%= render "layouts/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
