<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "SGA" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="SGA">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3">
        <%= link_to "SGA", root_path, class: "text-lg font-bold text-indigo-700" %>

        <% if user_signed_in? %>
          <nav class="flex flex-1 flex-wrap items-center gap-4 text-sm" aria-label="Principal">
            <% if can?(:read, :dashboard) %><%= nav_link_to "Dashboard", dashboard_path %><% end %>
            <% if can?(:index, :accounts) %><%= nav_link_to "Cuentas", accounts_path %><% end %>
            <% if can?(:assign_professor, Section) %><%= nav_link_to "Asignar profesores", teacher_assignments_path %><% end %>
            <% if can?(:index, CourseCoordinator) %><%= nav_link_to "Asignar coordinadores", course_coordinators_path %><% end %>
            <% if can?(:index, Course) %><%= nav_link_to(catalog_view? ? "Cursos" : "Mis cursos", courses_path) %><% end %>
            <% if can?(:index, :announcements) %><%= nav_link_to "Anuncios", announcements_path %><% end %>
            <% if can?(:index, :attendance) %><%= nav_link_to "Asistencia", attendance_path %><% end %>
            <% if can?(:read, :my_grades) %><%= nav_link_to "Mis notas", my_grades_path %><% end %>
            <% if can?(:read_grade_statuses, :reports) %><%= nav_link_to "Notas", reports_grade_statuses_path %><% end %>
            <% if can?(:read, :notifications) %>
              <% unread = current_user.notifications.unread.count %>
              <%= link_to notifications_path,
                          class: "relative inline-flex items-center rounded-lg p-1.5 text-slate-600 hover:bg-slate-100 hover:text-slate-900",
                          title: "Notificaciones",
                          aria: { label: unread.zero? ? "Notificaciones" : "Notificaciones, #{unread} sin leer" } do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" class="h-5 w-5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
                </svg>
                <% if unread.positive? %>
                  <span class="ml-1 rounded-full bg-indigo-600 px-1.5 py-0.5 text-xs font-semibold leading-none text-white">
                    <%= unread %>
                  </span>
                <% end %>
              <% end %>
            <% end %>
          </nav>

          <div class="flex flex-wrap items-center gap-3 text-sm">
            <% if can?(:switch, University) %>
              <%= form_with url: university_selection_path, method: :patch, class: "flex items-center gap-2" do |form| %>
                <%= form.label :university_id, "Universidad activa", class: "sr-only" %>
                <%= form.select :university_id, University.order(:name).pluck(:name, :id),
                      { selected: current_university&.id },
                      class: "rounded-md border border-slate-300 bg-white px-2 py-1.5 text-slate-700" %>
                <%= form.submit "Cambiar", class: "rounded-md border border-slate-300 px-3 py-1.5 text-slate-700 hover:bg-slate-50" %>
              <% end %>
            <% elsif current_university %>
              <span class="rounded-md bg-indigo-50 px-2 py-1 font-medium text-indigo-700"><%= current_university.name %></span>
            <% end %>
            <span class="text-slate-600"><%= current_user.name %> · <%= current_user.role_name %></span>
            <%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete,
                  class: "rounded-md border border-slate-300 px-3 py-1.5 text-slate-700 hover:bg-slate-50" %>
          </div>
        <% else %>
          <%= link_to "Iniciar sesión", new_user_session_path, class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
        <% end %>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4">
      <%= render "layouts/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
