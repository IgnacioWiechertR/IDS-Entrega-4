<div id="<%= dom_id attendance_session %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Section:</strong>
    <%= attendance_session.section_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Held on:</strong>
    <%= attendance_session.held_on %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Recorded by:</strong>
    <%= attendance_session.recorded_by_id %>
  </div>
</div>
