<% content_for :title, "Mis notas · SGA" %>

<section class="py-8">
  <h1 class="text-2xl font-bold text-slate-900">Mis notas</h1>
  <p class="mt-1 text-sm text-slate-600">Solo aparecen las notas oficiales, publicadas por el profesor.</p>

  <% if @grades_by_section.empty? %>
    <p id="no-grades" class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      Aún no tienes notas publicadas.
    </p>
  <% else %>
    <% @enrollments.each do |enrollment| %>
      <% section = enrollment.section %>
      <% grades = @grades_by_section[section.id] %>
      <article id="section_<%= section.id %>" class="mt-6 rounded-lg border border-slate-200 bg-white">
        <header class="border-b border-slate-100 px-5 py-3">
          <h2 class="font-semibold text-slate-900"><%= section.course.code %> · <%= section.course.name %></h2>
          <p class="text-sm text-slate-600">Sección <%= section.number %> · <%= section.term.name %></p>
        </header>

        <% if grades %>
          <table class="min-w-full divide-y divide-slate-100 text-sm">
            <thead class="text-left text-slate-600">
              <tr>
                <th class="px-5 py-2 font-semibold">Evaluación</th>
                <th class="px-5 py-2 font-semibold">Ponderación</th>
                <th class="px-5 py-2 font-semibold">Fecha</th>
                <th class="px-5 py-2 text-right font-semibold">Nota</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% grades.each do |grade| %>
                <tr id="<%= dom_id grade %>">
                  <td class="px-5 py-2"><%= link_to grade.evaluation.name, my_grade_path(grade), class: "font-medium text-indigo-700 hover:underline" %></td>
                  <td class="px-5 py-2"><%= weight_percentage(grade.evaluation.weight) %></td>
                  <td class="px-5 py-2"><%= l(grade.evaluation.due_on) %></td>
                  <td class="px-5 py-2 text-right text-base font-bold text-slate-900"><%= grade_score(grade) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="px-5 py-4 text-sm text-slate-600">Aún no tienes notas publicadas en esta asignatura.</p>
        <% end %>
      </article>
    <% end %>
  <% end %>
</section>
