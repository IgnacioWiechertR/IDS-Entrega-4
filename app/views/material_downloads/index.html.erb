<% content_for :title, "Descargar material · #{@course.code} · SGA" %>

<section class="py-8">
  <%= link_to "← Volver al curso", course_path(@course), class: "text-sm font-medium text-indigo-700 hover:underline" %>
  <p class="mt-4 text-sm text-indigo-700"><%= @course.university.name %> · <%= @course.code %></p>
  <h1 class="mt-2 text-2xl font-bold text-slate-900">Descargar material</h1>
  <p class="mt-2 text-slate-600"><%= @course.name %> · Selecciona un archivo para descargar su versión original.</p>

  <% if @materials.any? %>
    <ul id="material_downloads" class="mt-6 divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white">
      <% @materials.each do |material| %>
        <li id="<%= dom_id(material, :download) %>" class="flex flex-wrap items-center justify-between gap-3 px-4 py-4">
          <div class="min-w-0">
            <p class="break-words font-medium text-slate-900"><%= material.title %></p>
            <% if material.file.attached? %>
              <p class="mt-1 break-words text-sm text-slate-600"><%= material.file.filename %> · <%= number_to_human_size(material.file.byte_size) %></p>
            <% end %>
          </div>
          <%= material_download_link(@course, material) %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p id="material_downloads_empty" class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">Este curso aún no tiene material para descargar.</p>
  <% end %>
</section>
