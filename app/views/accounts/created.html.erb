<% content_for :title, "Cuenta creada · SGA" %>

<section class="mx-auto max-w-xl py-8">
  <p class="text-sm font-semibold text-indigo-600"><%= @account.university.name %></p>
  <h1 class="text-2xl font-bold text-slate-900">Cuenta creada</h1>

  <dl id="created_account" class="mt-6 grid grid-cols-3 gap-x-4 gap-y-2 text-sm">
    <dt class="text-slate-500">Nombre</dt>
    <dd class="col-span-2 font-medium text-slate-900"><%= @account.name %></dd>
    <dt class="text-slate-500">RUT</dt>
    <dd class="col-span-2 text-slate-900"><%= @account.rut %></dd>
    <dt class="text-slate-500">Correo</dt>
    <dd class="col-span-2 text-slate-900"><%= @account.email %></dd>
    <dt class="text-slate-500">Rol</dt>
    <dd class="col-span-2 text-slate-900"><%= @account.role_name %></dd>
  </dl>

  <div class="mt-6 rounded-md border border-amber-300 bg-amber-50 p-4" role="alert">
    <p class="text-sm font-semibold text-amber-900">Contraseña temporal</p>
    <p class="mt-2">
      <code id="temporary_password" class="select-all rounded bg-white px-3 py-1 font-mono text-lg text-slate-900"><%= @temporary_password %></code>
    </p>
    <p class="mt-2 text-sm text-amber-900">
      Cópiala y entrégasela a la persona. No se volverá a mostrar.
    </p>
  </div>

  <div class="mt-6 flex items-center gap-4">
    <%= link_to "Crear otra cuenta", new_account_path, class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
    <%= link_to "Volver a cuentas", accounts_path, class: "text-sm text-slate-600 hover:underline" %>
  </div>
</section>
