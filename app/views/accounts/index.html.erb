<% content_for :title, "Cuentas · SGA" %>

<section class="py-8">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold text-slate-900">Cuentas</h1>
    <% if can?(:create_account, User) %>
      <%= link_to "Crear cuenta", new_account_path, class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
    <% end %>
  </div>

  <% if @university %>
    <p class="mt-2 text-slate-600">
      Universidad activa:
      <strong><%= @university.name %></strong>
    </p>

    <%= form_with url: accounts_path, method: :get,
                  class: "mt-6 flex flex-wrap items-end gap-3" do |form| %>
      <div class="min-w-0 flex-1">
        <%= form.label :q, "Buscar por nombre o RUT",
              class: "mb-2 block text-sm font-medium text-slate-700" %>

        <%= form.search_field :q,
              value: @query,
              placeholder: "Ej.: Camila Torres o 16.789.012-1",
              class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2" %>
      </div>

      <div>
        <%= form.label :role, "Rol",
              class: "mb-2 block text-sm font-medium text-slate-700" %>

        <%= form.select :role,
              options_for_select(
                User.roles.keys.map { |role| [I18n.t("roles.#{role}"), role] },
                @role
              ),
              { include_blank: "Todos los roles" },
              class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2" %>
      </div>



      <%= form.submit "Buscar",
            class: "rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white" %>

      <%= link_to "Limpiar", accounts_path,
            class: "rounded-lg border border-slate-300 px-4 py-2 text-slate-700" %>
    <% end %>

    <% if @accounts.any? %>
      <div class="mt-6 overflow-x-auto rounded-lg border border-slate-200">
        <table class="min-w-full divide-y divide-slate-200">
          <caption class="sr-only">
            Cuentas de <%= @university.name %>
          </caption>

          <thead class="bg-slate-50">
            <tr>
              <% ["Nombre", "RUT", "Correo", "Rol"].each do |column| %>
                <th scope="col"
                    class="px-4 py-3 text-left text-sm font-semibold text-slate-700">
                  <%= column %>
                </th>
              <% end %>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-200 bg-white">
            <% @accounts.each do |account| %>
              <tr>
                <td class="px-4 py-4 text-sm font-medium text-slate-900">
                  <%= account.name %>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-sm text-slate-600">
                  <%= account.rut %>
                </td>
                <td class="px-4 py-4 text-sm text-slate-600">
                  <%= account.email %>
                </td>
                <td class="px-4 py-4 text-sm text-slate-600">
                  <%= account.role_name %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-slate-600">
          Mostrando <%= @accounts.size %> de <%= @total_accounts %> cuentas
        </p>

        <nav aria-label="Paginación de cuentas"
             class="flex flex-wrap items-center gap-3">
          <% if @page > 1 %>
            <%= link_to "Anterior",
                  accounts_path(q: @query, role: @role, page: @page - 1),
                  class: "rounded-lg border border-slate-300 px-3 py-2 text-slate-700" %>
          <% end %>

          <span class="text-sm text-slate-600">
            Página <%= @page %> de <%= @total_pages %>
          </span>

          <% if @page < @total_pages %>
            <%= link_to "Siguiente",
                  accounts_path(q: @query, role: @role, page: @page + 1),
                  class: "rounded-lg border border-slate-300 px-3 py-2 text-slate-700" %>
          <% end %>
        </nav>
      </div>
    <% else %>
      <div class="mt-6 rounded-lg border border-slate-200 bg-white p-8 text-center">
        <h2 class="text-lg font-semibold text-slate-900">
          No se encontraron cuentas
        </h2>
        <p class="mt-2 text-slate-600">
          No hay cuentas registradas en esta universidad.
        </p>
      </div>
    <% end %>
  <% else %>
    <p class="mt-6 text-slate-600">
      No hay una universidad activa disponible.
    </p>
  <% end %>
</section>
