<% content_for :title, "Cuentas · SGA" %>

<section class="py-8">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-2xl font-bold text-slate-900">Cuentas</h1>
    <div class="flex flex-wrap items-center gap-3">
      <% if current_user.director? && can?(:update_account, current_user) %>
        <%= link_to "Mi cuenta", edit_account_path(current_user),
                    class: "inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
      <% end %>
      <% if can?(:import, :accounts) %>
        <%= link_to "Importar CSV", import_accounts_path,
                    class: "inline-flex items-center rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
      <% end %>
      <% if can?(:create_account, User) %>
        <%= link_to "Crear cuenta", new_account_path,
                    class: "inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
      <% end %>
    </div>
  </div>

  <% if @university %>
    <p class="mt-2 text-slate-600">
      Universidad activa:
      <strong><%= @university.name %></strong>
    </p>

    <%= form_with url: accounts_path, method: :get,
                  class: "mt-6 flex flex-wrap items-end gap-3" do |form| %>
      <div class="min-w-0 flex-1">
        <%= form.label :q, "Buscar por nombre o RUT",
              class: "mb-2 block text-sm font-medium text-slate-700" %>

        <%= form.search_field :q,
              value: @query,
              placeholder: "Ej.: Camila Torres o 16.789.012-1",
              class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2" %>
      </div>

      <div>
        <%= form.label :role, "Rol",
              class: "mb-2 block text-sm font-medium text-slate-700" %>

        <%= form.select :role,
              options_for_select(
                User.roles.keys.map { |role| [I18n.t("roles.#{role}"), role] },
                @role
              ),
              { include_blank: "Todos los roles" },
              class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2" %>
      </div>



      <%= form.submit "Buscar",
            class: "rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white" %>

      <%= link_to "Limpiar", accounts_path,
            class: "rounded-lg border border-slate-300 px-4 py-2 text-slate-700" %>
    <% end %>

    <% if @accounts.any? %>
      <div class="mt-6 overflow-x-auto rounded-lg border border-slate-200">
        <table class="min-w-full divide-y divide-slate-200">
          <caption class="sr-only">
            Cuentas de <%= @university.name %>
          </caption>

          <thead class="bg-slate-50">
            <tr>
              <% ["Nombre", "RUT", "Correo", "Rol", "Estado", "Acciones"].each do |column| %>
                <th scope="col"
                    class="px-4 py-3 text-left text-sm font-semibold text-slate-700">
                  <%= column %>
                </th>
              <% end %>
            </tr>
          </thead>

          <tbody class="divide-y divide-slate-200 bg-white">
            <% @accounts.each do |account| %>
              <tr>
                <td class="px-4 py-4 text-sm font-medium text-slate-900">
                  <%= account.name %>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-sm text-slate-600">
                  <%= account.rut %>
                </td>
                <td class="px-4 py-4 text-sm text-slate-600">
                  <%= account.email %>
                </td>
                <td class="px-4 py-4 text-sm text-slate-600">
                  <% if can?(:change_role, account) %>
                    <%= form_with model: account,
                                  scope: :account,
                                  url: role_account_path(account, q: @query.presence, role: @role.presence, page: @page),
                                  method: :patch,
                                  class: "flex items-center gap-2" do |form| %>
                      <%= form.label :role, "Rol de #{account.name}", class: "sr-only" %>
                      <%= form.select :role,
                                      options_for_select(
                                        AccountPolicy::CREATABLE_ROLES.map { |role| [I18n.t("roles.#{role}"), role] },
                                        account.role
                                      ),
                                      {},
                                      class: "rounded-lg border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-700" %>
                      <%= form.submit "Guardar",
                                      class: "cursor-pointer rounded-lg bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-indigo-700" %>
                    <% end %>
                  <% else %>
                    <%= account.role_name %>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-sm">
                  <% if account.deactivated? %>
                    <span class="rounded-full bg-slate-200 px-2.5 py-0.5 text-xs font-semibold text-slate-700">Eliminada</span>
                  <% else %>
                    <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">Activa</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-sm">
                  <% filters = { q: @query.presence, role: @role.presence, page: @page }.compact %>
                  <div class="flex items-center gap-3">
                    <% if can?(:update_account, account) %>
                      <%= link_to "Editar", edit_account_path(account, **filters),
                                  class: "font-semibold text-indigo-600 hover:underline",
                                  aria: { label: "Editar la cuenta de #{account.name}" } %>
                    <% end %>
                    <% if account.deactivated? && can?(:reactivate_account, account) %>
                      <%= render "accounts/reactivate_button", account: account, filters: filters %>
                    <% elsif !account.deactivated? && can?(:destroy_account, account) %>
                      <%= render "accounts/delete_button", account: account, filters: filters %>
                    <% end %>
                    <% unless can?(:update_account, account) || can?(:destroy_account, account) %>
                      <span class="text-slate-400">—</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-slate-600">
          Mostrando <%= @accounts.size %> de <%= @total_accounts %> cuentas
        </p>

        <nav aria-label="Paginación de cuentas"
             class="flex flex-wrap items-center gap-3">
          <% if @page > 1 %>
            <%= link_to "Anterior",
                  accounts_path(q: @query, role: @role, page: @page - 1),
                  class: "rounded-lg border border-slate-300 px-3 py-2 text-slate-700" %>
          <% end %>

          <span class="text-sm text-slate-600">
            Página <%= @page %> de <%= @total_pages %>
          </span>

          <% if @page < @total_pages %>
            <%= link_to "Siguiente",
                  accounts_path(q: @query, role: @role, page: @page + 1),
                  class: "rounded-lg border border-slate-300 px-3 py-2 text-slate-700" %>
          <% end %>
        </nav>
      </div>
    <% else %>
      <div class="mt-6 rounded-lg border border-slate-200 bg-white p-8 text-center">
        <h2 class="text-lg font-semibold text-slate-900">
          No se encontraron cuentas
        </h2>
        <p class="mt-2 text-slate-600">
          <% if @query.present? || @role.present? %>
            No hay cuentas que coincidan con los filtros seleccionados en esta universidad.
          <% else %>
            No hay cuentas registradas en esta universidad.
          <% end %>
        </p>
      </div>
    <% end %>
  <% else %>
    <p class="mt-6 text-slate-600">
      No hay una universidad activa disponible.
    </p>
  <% end %>
</section>
