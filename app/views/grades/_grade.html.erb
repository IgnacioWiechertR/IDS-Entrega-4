<div id="<%= dom_id grade %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Evaluation:</strong>
    <%= grade.evaluation_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Student:</strong>
    <%= grade.student_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Score:</strong>
    <%= grade.score %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= grade.status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Feedback:</strong>
    <%= grade.feedback %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Rejection comment:</strong>
    <%= grade.rejection_comment %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Entered by:</strong>
    <%= grade.entered_by_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Reviewed by:</strong>
    <%= grade.reviewed_by_id %>
  </div>
</div>
