<%= form_with(model: grade, class: "contents") do |form| %>
  <% if grade.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(grade.errors.count, "error") %> prohibited this grade from being saved:</h2>

      <ul class="list-disc ml-6">
        <% grade.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :evaluation_id %>
    <%= form.text_field :evaluation_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": grade.errors[:evaluation_id].none?, "border-red-400 focus:outline-red-600": grade.errors[:evaluation_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :student_id %>
    <%= form.text_field :student_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": grade.errors[:student_id].none?, "border-red-400 focus:outline-red-600": grade.errors[:student_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :score %>
    <%= form.text_field :score, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": grade.errors[:score].none?, "border-red-400 focus:outline-red-600": grade.errors[:score].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :status %>
    <%= form.text_field :status, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": grade.errors[:status].none?, "border-red-400 focus:outline-red-600": grade.errors[:status].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :feedback %>
    <%= form.textarea :feedback, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": grade.errors[:feedback].none?, "border-red-400 focus:outline-red-600": grade.errors[:feedback].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :rejection_comment %>
    <%= form.textarea :rejection_comment, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": grade.errors[:rejection_comment].none?, "border-red-400 focus:outline-red-600": grade.errors[:rejection_comment].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :entered_by_id %>
    <%= form.text_field :entered_by_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": grade.errors[:entered_by_id].none?, "border-red-400 focus:outline-red-600": grade.errors[:entered_by_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :reviewed_by_id %>
    <%= form.text_field :reviewed_by_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": grade.errors[:reviewed_by_id].none?, "border-red-400 focus:outline-red-600": grade.errors[:reviewed_by_id].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
