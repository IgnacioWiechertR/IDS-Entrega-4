<% content_for :title, "Notificaciones · SGA" %>

<section class="mx-auto max-w-3xl py-8">
  <h1 class="text-2xl font-bold text-slate-900">Notificaciones</h1>

  <% if @notifications.empty? %>
    <p id="no-notifications" class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      No tienes notificaciones.
    </p>
  <% else %>
    <ul id="notifications" class="mt-6 divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white">
      <% @notifications.each do |notification| %>
        <%# Unread ones (when the page was opened) are shown in bold; opening the inbox marks them as read. %>
        <li id="<%= dom_id notification %>" class="flex items-start justify-between gap-4 px-5 py-3 text-sm <%= notification.read_at ? 'text-slate-600' : 'font-semibold text-slate-900' %>">
          <span><%= notification.message %></span>
          <time datetime="<%= notification.created_at.iso8601 %>" class="shrink-0 text-xs font-normal text-slate-500">
            <%= l(notification.created_at, format: "%d/%m %H:%M") %>
          </time>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
