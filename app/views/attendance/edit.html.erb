<% content_for :title, "Marcar asistencia · SGA" %>

<section class="py-8">
  <p class="text-sm"><%= link_to "← Asistencia de la sección", section_attendance_path(@section), class: "text-indigo-700 hover:underline" %></p>

  <h1 class="mt-2 text-2xl font-bold text-slate-900">Marcar asistencia</h1>
  <p class="mt-1 text-slate-600"><%= section_title(@section) %></p>

  <%= form_with url: edit_section_attendance_path(@section), method: :get, class: "mt-6 flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :date, "Fecha de la clase", class: "block text-sm font-medium text-slate-700" %>
      <%= form.date_field :date, value: @held_on, max: Date.current, class: ApplicationHelper::INPUT_CLASSES %>
    </div>
    <%= form.submit "Cambiar fecha", name: nil,
          class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
  <% end %>

  <% if @errors&.any? %>
    <div id="error_explanation" class="mt-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <ul><% @errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <% if @session %>
    <p id="already-recorded" class="mt-4 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      El <%= l(@held_on) %> ya tiene asistencia registrada (última vez por <%= @session.recorded_by.name %>). Al guardar se corrigen las marcas.
    </p>
  <% end %>

  <%= form_with scope: :attendance, url: section_attendance_path(@section), method: :patch, class: "mt-4" do |form| %>
    <%= form.hidden_field :held_on, value: @held_on.iso8601 %>

    <% if @calculator.students.empty? %>
      <p id="no-students" class="rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
        Sección sin matrículas activas.
      </p>
    <% else %>
      <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table id="attendance-list" class="min-w-full text-sm">
          <thead class="bg-slate-50 text-left text-slate-700">
            <tr>
              <th scope="col" class="px-3 py-2 font-semibold">Alumno</th>
              <th scope="col" class="px-3 py-2 text-center font-semibold">Presente</th>
              <th scope="col" class="px-3 py-2 text-center font-semibold">Ausente</th>
              <th scope="col" class="px-3 py-2 text-right font-semibold">Asistencia actual</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @calculator.students.each do |student| %>
              <% status = @calculator.status(student, @session) || "presente" %>
              <tr>
                <th scope="row" class="whitespace-nowrap px-3 py-2 text-left font-medium text-slate-900"><%= student.name %></th>
                <% AttendanceRecord.statuses.each_key do |option| %>
                  <td class="px-3 py-2 text-center">
                    <%= radio_button_tag "attendance[statuses][#{student.id}]", option, status == option,
                          id: "status_#{student.id}_#{option}", class: "h-4 w-4 accent-indigo-600",
                          aria: { label: "#{attendance_status_label(option)}: #{student.name}" } %>
                  </td>
                <% end %>
                <td class="whitespace-nowrap px-3 py-2 text-right text-slate-600"><%= attendance_percentage(@calculator.percentage(student)) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <div class="mt-4">
      <%= form.submit "Guardar asistencia", disabled: @calculator.students.empty?,
            class: "#{ApplicationHelper::PRIMARY_BUTTON_CLASSES} disabled:cursor-not-allowed disabled:opacity-50" %>
    </div>
  <% end %>
</section>
