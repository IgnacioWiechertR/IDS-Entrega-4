<% content_for :title, "Asistencia de la sección · SGA" %>

<section class="py-8">
  <p class="text-sm">
    <% if can?(:index, :attendance) %>
      <%= link_to "← Asistencia", attendance_path, class: "text-indigo-700 hover:underline" %>
    <% else %>
      <%= link_to "← Sección", course_section_path(@section.course, @section), class: "text-indigo-700 hover:underline" %>
    <% end %>
  </p>

  <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Asistencia de la sección</h1>
      <p class="mt-1 text-slate-600"><%= section_title(@section) %></p>
    </div>
    <% if can?(:take_attendance, @section) %>
      <%= link_to "Marcar asistencia de hoy", edit_section_attendance_path(@section), class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
    <% end %>
  </div>

  <% if @calculator.students.empty? %>
    <p id="no-students" class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      Sección sin matrículas activas.
    </p>
  <% elsif @calculator.sessions.empty? %>
    <p id="no-sessions" class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      Aún no hay clases registradas en esta sección.
    </p>
  <% else %>
    <p class="mt-6 text-sm text-slate-600">
      P: presente · A: ausente · —: sin marca.<% if can?(:take_attendance, @section) %> Haz clic en una fecha para corregir sus marcas.<% end %>
    </p>
    <div class="mt-2 overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table id="attendance-table" class="min-w-full text-sm">
        <thead class="bg-slate-50 text-left text-slate-700">
          <tr>
            <th scope="col" class="px-3 py-2 font-semibold">Alumno</th>
            <% @calculator.sessions.each do |session| %>
              <th scope="col" class="px-2 py-2 text-center font-semibold">
                <% if can?(:take_attendance, @section) %>
                  <%= link_to l(session.held_on, format: "%d/%m"), edit_section_attendance_path(@section, date: session.held_on.iso8601),
                        class: "text-indigo-700 hover:underline", title: "Corregir el #{l(session.held_on)}" %>
                <% else %>
                  <%= l(session.held_on, format: "%d/%m") %>
                <% end %>
              </th>
            <% end %>
            <th scope="col" class="px-3 py-2 text-right font-semibold">Asistencia</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @calculator.students.each do |student| %>
            <tr>
              <th scope="row" class="whitespace-nowrap px-3 py-2 text-left font-medium text-slate-900"><%= student.name %></th>
              <% @calculator.sessions.each do |session| %>
                <% status = @calculator.status(student, session) %>
                <td class="px-2 py-2 text-center">
                  <span class="inline-block w-7 rounded <%= attendance_status_classes(status) %>" title="<%= attendance_status_label(status) %>">
                    <%= status ? status.first.upcase : "—" %>
                  </span>
                </td>
              <% end %>
              <td class="whitespace-nowrap px-3 py-2 text-right font-semibold"><%= attendance_percentage(@calculator.percentage(student)) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
