<% content_for :title, "Mi asistencia · SGA" %>

<section class="py-8">
  <p class="text-sm"><%= link_to "← Asistencia", attendance_path, class: "text-indigo-700 hover:underline" %></p>

  <h1 class="mt-2 text-2xl font-bold text-slate-900">Mi asistencia</h1>
  <p class="mt-1 text-slate-600"><%= section_title(@section) %></p>

  <% if @calculator.sessions.empty? %>
    <p id="no-sessions" class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      Aún no hay clases registradas en esta sección.
    </p>
  <% else %>
    <div class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
      <p id="attendance-percentage" class="text-3xl font-bold text-indigo-700">
        <%= attendance_percentage(@calculator.percentage(current_user)) %>
      </p>
      <p class="mt-1 text-sm text-slate-600">
        Asististe a <%= @calculator.present_count(current_user) %> de <%= @calculator.sessions.size %> clases registradas.
      </p>
    </div>

    <ul id="attendance-detail" class="mt-4 divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white">
      <% @calculator.sessions.reverse_each do |session| %>
        <% status = @calculator.status(current_user, session) %>
        <li class="flex items-center justify-between px-4 py-2 text-sm">
          <span class="text-slate-700"><%= l(session.held_on, format: :long) %></span>
          <span class="rounded px-2 py-0.5 font-medium <%= attendance_status_classes(status) %>"><%= attendance_status_label(status) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
