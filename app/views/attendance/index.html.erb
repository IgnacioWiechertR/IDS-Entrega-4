<% content_for :title, "Asistencia · SGA" %>

<section class="py-8">
  <h1 class="text-2xl font-bold text-slate-900">Asistencia</h1>

  <% if @taught_sections.any? %>
    <h2 class="mt-6 text-lg font-semibold text-slate-900">Secciones que dictas</h2>
    <ul id="taught-sections" class="mt-3 grid gap-4 sm:grid-cols-2">
      <% @taught_sections.each do |section| %>
        <li class="rounded-lg border border-slate-200 bg-white p-5">
          <p class="font-semibold text-slate-900"><%= section_title(section) %></p>
          <div class="mt-3 flex flex-wrap gap-2 text-sm">
            <%= link_to "Ver asistencia", section_attendance_path(section), class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
            <%= link_to "Marcar asistencia de hoy", edit_section_attendance_path(section),
                  class: "inline-flex rounded-md border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if current_user.student_account? %>
    <h2 class="mt-6 text-lg font-semibold text-slate-900">Mi asistencia</h2>
    <% if @enrolled_sections.any? %>
      <ul id="my-attendance" class="mt-3 grid gap-4 sm:grid-cols-2">
        <% @enrolled_sections.each do |section| %>
          <li>
            <%= link_to section_attendance_path(section), class: "block rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-300" do %>
              <p class="font-semibold text-slate-900"><%= section_title(section) %></p>
              <p class="mt-2 text-2xl font-bold text-indigo-700">
                <%= attendance_percentage(AttendanceCalculatorService.new(section).percentage(current_user)) %>
              </p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
        No estás inscrito en ninguna sección.
      </p>
    <% end %>
  <% elsif @taught_sections.none? %>
    <p class="mt-4 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      Todavía no eres profesor de ninguna sección.
    </p>
  <% end %>
</section>
