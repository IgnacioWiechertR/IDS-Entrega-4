<% content_for :title, "#{@course.code} · Sección #{@section.number} · SGA" %>

<section class="py-8 md:w-2/3">
  <nav class="text-sm text-slate-600" aria-label="Ruta">
    <%= link_to "#{@course.code} #{@course.name}", @course, class: "text-indigo-700 hover:underline" %>
    <span aria-hidden="true">›</span>
    <span>Sección <%= @section.number %></span>
  </nav>
  <h1 class="mt-2 text-2xl font-bold text-slate-900"><%= @course.name %> · Sección <%= @section.number %></h1>

  <%= render @section %>

  <div class="mt-8 flex flex-wrap items-center gap-2 text-sm">
    <% if can?(:read_attendance_sheet, @section) %>
      <%= link_to "Asistencia", section_attendance_path(@section), class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
    <% end %>
    <% if can?(:read_gradebook, @section) %>
      <%= link_to "Notas", section_gradebook_path(@section), class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
    <% end %>
    <% if can?(:create, Evaluation.new(section: @section)) %>
      <%= link_to "Evaluaciones", section_evaluations_path(@section), class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
    <% end %>
    <% if can?(:manage, Enrollment.new(section: @section)) %>
      <%= link_to "Gestionar alumnos", course_section_enrollments_path(@course, @section), class: "rounded-md border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50" %>
    <% end %>
    <% if can?(:update, @section) %>
      <%= link_to "Editar sección", edit_course_section_path(@course, @section), class: "rounded-md border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50" %>
    <% end %>
    <%= link_to "Volver a secciones", course_sections_path(@course), class: "rounded-md border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50" %>
    <% if can?(:destroy, @section) %>
      <%= button_to "Eliminar sección", course_section_path(@course, @section), method: :delete,
            form: { data: { turbo_confirm: "¿Eliminar la sección #{@section.number} de #{@course.code} (#{@section.term.name})? Esta acción no se puede deshacer." } },
            class: "rounded-md bg-red-600 px-4 py-2 font-semibold text-white hover:bg-red-500 cursor-pointer" %>
    <% end %>
  </div>
</section>
