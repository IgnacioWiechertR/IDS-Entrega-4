<div class="mx-auto flex max-w-3xl flex-col gap-6 px-4 py-8">
  <% if notice.present? %>
    <p class="rounded-lg bg-green-50 px-3 py-2 font-medium text-green-500" id="notice"><%= notice %></p>
  <% end %>

  <%= render @section %>

  <div class="flex flex-wrap items-center gap-4">
    <% if @course %>
      <%= link_to "Edit this section", edit_course_section_path(@course, @section), class: "rounded-md bg-slate-100 px-3.5 py-2.5 font-medium text-slate-700 hover:bg-slate-200" %>
      <%= link_to "Back to sections", course_sections_path(@course), class: "font-medium text-indigo-600 hover:underline" %>
      <%= button_to "Destroy this section", course_section_path(@course, @section), method: :delete, data: { turbo_confirm: "¿Estás seguro?" }, class: "rounded-md bg-red-600 px-3.5 py-2.5 font-medium text-white hover:bg-red-500" %>
    <% else %>
      <%= link_to "Edit this section", edit_section_path(@section), class: "rounded-md bg-slate-100 px-3.5 py-2.5 font-medium text-slate-700 hover:bg-slate-200" %>
      <%= link_to "Back to sections", sections_path, class: "font-medium text-indigo-600 hover:underline" %>
      <%= button_to "Destroy this section", section_path(@section), method: :delete, data: { turbo_confirm: "¿Estás seguro?" }, class: "rounded-md bg-red-600 px-3.5 py-2.5 font-medium text-white hover:bg-red-500" %>
    <% end %>
  </div>
</div>