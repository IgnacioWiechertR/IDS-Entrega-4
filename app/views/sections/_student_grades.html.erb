<h2 class="mt-6 text-lg font-semibold text-slate-900">Mis notas</h2>
<p class="mt-1 text-sm text-slate-600">Solo aparecen las notas oficiales, publicadas por el profesor.</p>

<% if @stats.evaluations.any? %>
  <div class="mt-3 overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table id="my_section_grades" class="min-w-full divide-y divide-slate-200 text-sm">
      <thead class="bg-slate-50 text-left text-slate-600">
        <tr>
          <th scope="col" class="px-4 py-2 font-semibold">Evaluación</th>
          <th scope="col" class="px-4 py-2 font-semibold">Ponderación</th>
          <th scope="col" class="px-4 py-2 text-center font-semibold">Nota</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @stats.evaluations.each do |evaluation| %>
          <% grade = @stats.grade(current_user, evaluation) %>
          <tr>
            <td class="px-4 py-2 font-medium text-slate-900"><%= evaluation.name %></td>
            <td class="px-4 py-2 text-slate-700"><%= number_to_percentage(evaluation.weight, precision: 0) %></td>
            <%# Only published grades are visible to the student, and they open their "Detalle de entrega" (C14). %>
            <td class="px-4 py-2 text-center">
              <% if grade&.publicada? %>
                <%= link_to grade_score(grade), my_grade_path(grade), class: "font-semibold text-indigo-700 hover:underline" %>
              <% else %>
                <span class="text-slate-400">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p id="my_section_average" class="mt-3 text-sm text-slate-700">
    Mi promedio: <span class="font-semibold text-slate-900"><%= grade_average(@stats.student_average(current_user)) %></span>
  </p>
<% else %>
  <p id="no_section_evaluations" class="mt-3 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
    Esta sección aún no tiene evaluaciones.
  </p>
<% end %>

<% if can?(:read, :my_grades) %>
  <p class="mt-4 text-sm"><%= link_to "Ver todas mis notas", my_grades_path, class: "font-medium text-indigo-700 hover:underline" %></p>
<% end %>
