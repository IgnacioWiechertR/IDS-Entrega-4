<%= form_with(model: [@course, section], class: "contents") do |form| %>
  <% if section.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(section.errors.count, "error") %> prohibited this section from being saved:</h2>

      <ul class="list-disc ml-6">
        <% section.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Campos heredados (Solo lectura) -->
  <div class="my-5">
    <label class="block font-medium text-slate-700">Universidad</label>
    <div class="mt-2 px-3 py-2 bg-slate-50 border border-slate-200 rounded-md text-slate-500 cursor-not-allowed">
      <%= @course.university.name %>
    </div>
  </div>

  <div class="my-5">
    <label class="block font-medium text-slate-700">Curso</label>
    <div class="mt-2 px-3 py-2 bg-slate-50 border border-slate-200 rounded-md text-slate-500 cursor-not-allowed">
      <%= @course.code %> - <%= @course.name %>
    </div>
  </div>

  <!-- Campos editables -->
  <div class="my-5">
    <%= form.label :term_id, "Periodo Académico" %>
    <!-- Reemplazamos el text_field por un collection_select -->
    <%= form.collection_select :term_id, @course.university.terms, :id, :name, { prompt: "Selecciona un periodo..." }, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full bg-white", {"border-gray-400 focus:outline-blue-600": section.errors[:term_id].none?, "border-red-400 focus:outline-red-600": section.errors[:term_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :number, "Número de Sección" %>
    <%= form.number_field :number, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": section.errors[:number].none?, "border-red-400 focus:outline-red-600": section.errors[:number].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
