<%= form_with(model: [ @course, section ], class: "mt-6 space-y-5") do |form| %>
  <% if section.errors.any? %>
    <div id="error_explanation" class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <p class="font-medium">No se pudo guardar la sección:</p>
      <ul class="ml-5 mt-1 list-disc">
        <% section.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <p class="block text-sm font-medium text-slate-700">Curso</p>
    <p class="mt-1 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-slate-600"><%= @course.code %> · <%= @course.name %></p>
  </div>

  <div>
    <%= form.label :term_id, class: "block text-sm font-medium text-slate-700" %>
    <%# Term is scoped to the active university (A3): only its periods are listed, newest first. %>
    <%= form.collection_select :term_id, Term.order(starts_on: :desc), :id, :name,
          { prompt: "Selecciona un período" }, required: true, class: ApplicationHelper::INPUT_CLASSES %>
  </div>

  <div>
    <%= form.label :number, class: "block text-sm font-medium text-slate-700" %>
    <%= form.number_field :number, min: 1, step: 1, required: true, class: ApplicationHelper::INPUT_CLASSES %>
  </div>

  <%= form.submit section.new_record? ? "Crear sección" : "Guardar cambios", class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
<% end %>
