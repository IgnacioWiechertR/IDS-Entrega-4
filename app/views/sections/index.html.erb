<% content_for :title, "Sections" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <% if @course %>
      <h1 class="font-bold text-4xl">Secciones de <%= @course.name %></h1>
      <%= link_to "New section", new_course_section_path(@course), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
    <% else %>
      <h1 class="font-bold text-4xl">Secciones</h1>
      <%= link_to "New section", new_section_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
    <% end %>
  </div>

  <div id="sections" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% @sections.each do |section| %>
      <%= render section %>
      <p>
        <% if @course %>
          <%= link_to "Show this section", course_section_path(@course, section) %>
        <% else %>
          <%= link_to "Show this section", section_path(section) %>
        <% end %>
      </p>
    <% end %>
  </div>
</div>