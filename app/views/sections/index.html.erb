<% content_for :title, "Secciones de #{@course.code} · SGA" %>

<section class="py-8">
  <p class="text-sm">
    <%= link_to "← #{@course.code} #{@course.name}", @course, class: "text-indigo-700 hover:underline" %>
  </p>

  <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold text-slate-900">Secciones de <%= @course.name %></h1>
    <% if can?(:create, Section.new(course: @course)) %>
      <%= link_to "Nueva sección", new_course_section_path(@course), class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
    <% end %>
  </div>

  <% if @sections.any? %>
    <ul id="sections" class="mt-6 grid gap-4 sm:grid-cols-2">
      <% @sections.each do |section| %>
        <li id="<%= dom_id section %>" class="flex h-full flex-col rounded-lg border border-slate-200 bg-white p-5">
          <p class="text-sm font-semibold text-indigo-600"><%= section.term.name %></p>
          <p class="mt-1 font-semibold text-slate-900">Sección <%= section.number %></p>

          <div class="mt-4 flex flex-wrap gap-2 text-sm">
            <%= link_to "Ver", course_section_path(@course, section), class: "rounded-md border border-slate-300 px-3 py-1.5 font-medium text-slate-700 hover:bg-slate-50" %>
            <% if can?(:update, section) %>
              <%= link_to "Editar", edit_course_section_path(@course, section), class: "rounded-md border border-slate-300 px-3 py-1.5 font-medium text-slate-700 hover:bg-slate-50" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% elsif can?(:create, Section.new(course: @course)) %>
    <div id="sections_empty" class="mt-4 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      <p>Este curso todavía no tiene secciones.</p>
      <%= link_to "Crear la primera sección", new_course_section_path(@course), class: "#{ApplicationHelper::PRIMARY_BUTTON_CLASSES} mt-4" %>
    </div>
  <% else %>
    <p id="sections_empty" class="mt-4 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      Este curso todavía no tiene secciones.
    </p>
  <% end %>
</section>
