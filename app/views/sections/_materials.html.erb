<h2 class="mt-8 text-lg font-semibold text-slate-900">Material académico</h2>
<% if can?(:create, Material.new(course: @course)) %>
  <p class="mt-3"><%= link_to "Subir material", new_course_material_path(@course), class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %></p>
<% end %>
<% if @materials.any? %>
  <ul id="materials" class="mt-3 divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white">
    <% @materials.each do |material| %>
      <li class="px-4 py-3 text-sm">
        <% if material.file.attached? %>
          <%# B2: the title opens the detail and preview; B5: the button next to it downloads the original. %>
          <%= link_to material.title.presence || material.file.filename.to_s, course_material_path(@course, material),
                class: "font-medium text-indigo-700 hover:underline" %>
          <span class="ml-3"><%= material_download_link(@course, material) %></span>
        <% else %>
          <%= link_to material_display_title(material), course_material_path(@course, material), class: "font-medium text-indigo-700 hover:underline" %>
        <% end %>
        <% if can?(:update, material) %>
          <%= link_to "Editar", edit_course_material_edit_path(@course, material), class: "ml-3 font-medium text-indigo-700 hover:underline" %>
        <% end %>
        <% if can?(:destroy, material) %>
          <%= link_to "Eliminar", course_material_deletion_path(@course, material), class: "ml-3 font-medium text-red-700 hover:underline" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="mt-3 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">Este curso aún no tiene material.</p>
<% end %>
