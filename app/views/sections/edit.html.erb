<% content_for :title, "Editar sección · SGA" %>

<section class="py-8 md:w-2/3">
  <h1 class="text-2xl font-bold text-slate-900">Editar sección <%= @section.number %> de <%= @course.code %></h1>

  <%= render "form", section: @section %>

  <%= link_to "Volver a la sección", course_section_path(@course, @section), class: "mt-4 inline-block text-sm font-medium text-slate-600 hover:text-slate-900" %>
</section>
