<div id="<%= dom_id section %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">University:</strong>
    <%= section.university.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Course:</strong>
    <%= section.course.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Term:</strong>
    <%= section.term.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Number:</strong>
    <%= section.number %>
  </div>
</div>
