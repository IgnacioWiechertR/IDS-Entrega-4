<dl id="<%= dom_id section %>" class="mt-6 space-y-4">
  <div>
    <dt class="text-sm font-medium text-slate-500">Curso</dt>
    <dd class="text-slate-900"><%= section.course.code %> · <%= section.course.name %></dd>
  </div>
  <div>
    <dt class="text-sm font-medium text-slate-500">Período</dt>
    <dd class="text-slate-900"><%= section.term.name %> (<%= l(section.term.starts_on) %> – <%= l(section.term.ends_on) %>)</dd>
  </div>
  <div>
    <dt class="text-sm font-medium text-slate-500">Número</dt>
    <dd class="text-slate-900"><%= section.number %></dd>
  </div>
</dl>
