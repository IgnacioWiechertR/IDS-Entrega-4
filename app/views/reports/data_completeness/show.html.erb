<% content_for :title, "Completitud de datos · SGA" %>
<section class="py-8">
  <h1 class="text-2xl font-bold">Completitud de datos</h1>
  <p class="mt-2 text-slate-600">Secciones con información pendiente de <strong><%= current_university.name %></strong>.</p>
  <p class="mt-2 text-sm text-slate-600">Se revisan todos los períodos. Cada evaluación debe tener notas oficiales para todos sus alumnos activos. Una sesión sin marcas no cuenta como asistencia registrada.</p>

  <% if @rows.empty? %>
    <p class="mt-6 rounded-lg border border-emerald-200 bg-emerald-50 p-5" role="status">No se encontraron secciones con datos incompletos.</p>
  <% else %>
    <p class="my-5 font-medium">Secciones por revisar: <%= @rows.size %></p>
    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table class="w-full text-left text-sm">
        <caption class="sr-only">Secciones con datos incompletos y acceso para corregirlas</caption>
        <thead class="bg-slate-100"><tr>
          <th scope="col" class="p-4">Asignatura y sección</th>
          <th scope="col" class="p-4">Período</th>
          <th scope="col" class="p-4">Datos pendientes</th>
          <th scope="col" class="p-4">Acción</th>
        </tr></thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr class="border-t border-slate-200">
              <th scope="row" class="p-4 font-medium"><%= row.section.course.code %> · <%= row.section.course.name %> · Sección <%= row.section.number %></th>
              <td class="p-4"><%= row.section.term.name %></td>
              <td class="p-4"><ul class="list-disc space-y-1 pl-5 text-amber-800"><% row.issues.each do |issue| %><li><%= issue %></li><% end %></ul></td>
              <td class="p-4"><%= link_to "Revisar sección", course_section_path(row.section.course, row.section), class: "inline-block rounded-md px-3 py-2 font-semibold text-indigo-700 hover:bg-indigo-50 focus-visible:outline-2 focus-visible:outline-indigo-600" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
