<% content_for :title, "Estado de notas por sección · SGA" %>

<section class="mx-auto max-w-6xl">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Estado de notas por sección</h1>
      <% if @university %>
        <p class="mt-1 text-slate-600">
          Universidad activa: <strong><%= @university.name %></strong>
        </p>
      <% end %>
    </div>

    <% if can?(:read_consolidated, :reports) %>
      <%= link_to "Reporte consolidado",
                  reports_consolidated_path(term_id: @selected_term_id),
                  class: "inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
    <% end %>

  </div>

  <% if @university %>
    <%= form_with url: reports_grade_statuses_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3" do |form| %>
      <div>
        <%= form.label :term_id, "Período", class: "mb-2 block text-sm font-medium text-slate-700" %>
        <%= form.select :term_id,
                        options_from_collection_for_select(@terms, :id, :name, @selected_term_id),
                        { include_blank: "Todos los períodos" },
                        class: "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700" %>
      </div>
      <%= form.submit "Filtrar", class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700" %>
      <% if @selected_term_id.present? %>
        <%= link_to "Limpiar", reports_grade_statuses_path, class: "rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-700" %>
      <% end %>
    <% end %>

    <% if @rows.any? %>
      <div class="mt-6 overflow-x-auto rounded-lg border border-slate-200">
        <table class="min-w-full divide-y divide-slate-200">
          <caption class="sr-only">
            Conteo de notas preliminares, rechazadas y oficiales por sección en <%= @university.name %>
          </caption>
          <thead class="bg-slate-50">
            <tr>
              <th scope="col" class="px-4 py-3 text-left text-sm font-semibold text-slate-700">Asignatura</th>
              <th scope="col" class="px-4 py-3 text-left text-sm font-semibold text-slate-700">Sección</th>
              <th scope="col" class="px-4 py-3 text-left text-sm font-semibold text-slate-700">Período</th>
              <th scope="col" class="px-4 py-3 text-left text-sm font-semibold text-slate-700">Profesor</th>
              <th scope="col" class="px-4 py-3 text-right text-sm font-semibold text-amber-700">Preliminares</th>
              <th scope="col" class="px-4 py-3 text-right text-sm font-semibold text-rose-700">Rechazadas</th>
              <th scope="col" class="px-4 py-3 text-right text-sm font-semibold text-emerald-700">Oficiales</th>
              <th scope="col" class="px-4 py-3 text-right text-sm font-semibold text-slate-700">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white">
            <% @rows.each do |row| %>
              <tr id="section-grade-status-<%= row.section.id %>">
                <td class="px-4 py-4 text-sm font-medium text-slate-900">
                  <%= row.course.code %> · <%= row.course.name %>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-sm text-slate-600">
                  Sección <%= row.section.number %>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-sm text-slate-600">
                  <%= row.term.name %>
                </td>
                <td class="px-4 py-4 text-sm text-slate-600">
                  <%= row.professor_name %>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-right text-sm font-semibold text-amber-700">
                  <%= row.preliminares %>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-right text-sm font-semibold text-rose-700">
                  <%= row.rechazadas %>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-right text-sm font-semibold text-emerald-700">
                  <%= row.oficiales %>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-right text-sm text-slate-700">
                  <%= row.total %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="mt-6 rounded-lg border border-slate-200 bg-white p-8 text-center">
        <h2 class="text-lg font-semibold text-slate-900">No hay secciones registradas</h2>
        <p class="mt-2 text-slate-600">No se encontraron secciones para los criterios seleccionados en esta universidad.</p>
      </div>
    <% end %>
  <% else %>
    <p class="mt-6 text-slate-600">No hay una universidad activa disponible.</p>
  <% end %>
</section>