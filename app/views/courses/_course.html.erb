<dl id="<%= dom_id course %>" class="mt-6 space-y-4">
  <div>
    <dt class="text-sm font-medium text-slate-500">Código</dt>
    <dd class="text-slate-900"><%= course.code %></dd>
  </div>
  <div>
    <dt class="text-sm font-medium text-slate-500">Nombre</dt>
    <dd class="text-slate-900"><%= course.name %></dd>
  </div>
  <div>
    <dt class="text-sm font-medium text-slate-500">Facultad</dt>
    <dd class="text-slate-900"><%= course.faculty.name %></dd>
  </div>
  <div>
    <dt class="text-sm font-medium text-slate-500">Universidad</dt>
    <dd class="text-slate-900"><%= course.university.name %></dd>
  </div>
</dl>
