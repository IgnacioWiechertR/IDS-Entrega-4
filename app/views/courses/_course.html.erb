<div id="<%= dom_id course %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">University:</strong>
    <%= course.university_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Faculty:</strong>
    <%= course.faculty_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Code:</strong>
    <%= course.code %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= course.name %>
  </div>
</div>
