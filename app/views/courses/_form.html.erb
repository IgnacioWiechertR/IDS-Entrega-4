<%= form_with(model: course, class: "mt-6 space-y-5") do |form| %>
  <% if course.errors.any? %>
    <div id="error_explanation" class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <p class="font-medium">No se pudo guardar el curso:</p>
      <ul class="ml-5 mt-1 list-disc">
        <% course.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :code, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :code, required: true, class: ApplicationHelper::INPUT_CLASSES %>
  </div>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :name, required: true, class: ApplicationHelper::INPUT_CLASSES %>
  </div>

  <div>
    <%= form.label :faculty_id, class: "block text-sm font-medium text-slate-700" %>
    <%# Faculty is scoped to the active university (A3): only its faculties are listed. %>
    <%= form.collection_select :faculty_id, Faculty.order(:name), :id, :name,
          { prompt: "Selecciona una facultad" }, required: true, class: ApplicationHelper::INPUT_CLASSES %>
  </div>

  <%= form.submit course.new_record? ? "Crear curso" : "Guardar cambios", class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
<% end %>
