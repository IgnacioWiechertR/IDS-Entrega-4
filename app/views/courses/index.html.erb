<% admin = current_user.administrativo? %>
<% title = admin ? "Cursos" : "Mis cursos" %>
<% content_for :title, "#{title} · SGA" %>

<section class="py-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold text-slate-900"><%= title %></h1>
    <% if can?(:create, Course) && @courses.any? %>
      <%= link_to "Nuevo curso", new_course_path, class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
    <% end %>
  </div>

  <% if @courses.any? %>
    <ul id="courses" class="mt-6 grid gap-4 sm:grid-cols-2">
      <% @courses.each do |course| %>
        <li>
          <% if admin %>
            <%# The card has buttons, so it is not a link itself (a link cannot contain other links). %>
            <div id="<%= dom_id course %>" class="flex h-full flex-col rounded-lg border border-slate-200 bg-white p-5">
              <p class="text-sm font-semibold text-indigo-600"><%= course.code %></p>
              <p class="mt-1 font-semibold text-slate-900"><%= course.name %></p>

              <dl class="mt-3 space-y-1 text-sm text-slate-600">
                <div class="flex gap-1">
                  <dt class="font-medium text-slate-700">Facultad:</dt>
                  <dd><%= course.faculty.name %></dd>
                </div>
                <div class="flex gap-1">
                  <dt class="font-medium text-slate-700">Coordinador:</dt>
                  <dd><%= @coordinators[course.id]&.user&.name || "Sin coordinador" %></dd>
                </div>
              </dl>

              <div class="mt-4 flex flex-wrap gap-2 text-sm">
                <%= link_to "Ver", course, class: "rounded-md border border-slate-300 px-3 py-1.5 font-medium text-slate-700 hover:bg-slate-50" %>
                <%= link_to "Secciones", course_sections_path(course), class: "rounded-md border border-slate-300 px-3 py-1.5 font-medium text-slate-700 hover:bg-slate-50" %>
                <% if can?(:update, course) %>
                  <%= link_to "Editar", edit_course_path(course), class: "rounded-md border border-slate-300 px-3 py-1.5 font-medium text-slate-700 hover:bg-slate-50" %>
                <% end %>
              </div>
            </div>
          <% else %>
            <%= link_to course, class: "block rounded-lg border border-slate-200 bg-white p-5 hover:border-indigo-300" do %>
              <p class="text-sm font-semibold text-indigo-600"><%= course.code %></p>
              <p class="mt-1 font-semibold text-slate-900"><%= course.name %></p>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% elsif can?(:create, Course) %>
    <div id="courses_empty" class="mt-4 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      <p>Todavía no hay cursos en tu universidad.</p>
      <%= link_to "Crear el primer curso", new_course_path, class: "#{ApplicationHelper::PRIMARY_BUTTON_CLASSES} mt-4" %>
    </div>
  <% else %>
    <p class="mt-4 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      Todavía no tienes cursos asignados.
    </p>
  <% end %>
</section>
