<%= form_with(model: course_coordinator, class: "contents") do |form| %>
  <% if course_coordinator.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(course_coordinator.errors.count, "error") %> prohibited this course_coordinator from being saved:</h2>

      <ul class="list-disc ml-6">
        <% course_coordinator.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :course_id %>
    <%= form.text_field :course_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": course_coordinator.errors[:course_id].none?, "border-red-400 focus:outline-red-600": course_coordinator.errors[:course_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :term_id %>
    <%= form.text_field :term_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": course_coordinator.errors[:term_id].none?, "border-red-400 focus:outline-red-600": course_coordinator.errors[:term_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :user_id %>
    <%= form.text_field :user_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": course_coordinator.errors[:user_id].none?, "border-red-400 focus:outline-red-600": course_coordinator.errors[:user_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :assigned_by_id %>
    <%= form.text_field :assigned_by_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": course_coordinator.errors[:assigned_by_id].none?, "border-red-400 focus:outline-red-600": course_coordinator.errors[:assigned_by_id].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
