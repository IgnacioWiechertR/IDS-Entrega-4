<div id="<%= dom_id course_coordinator %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Course:</strong>
    <%= course_coordinator.course_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Term:</strong>
    <%= course_coordinator.term_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= course_coordinator.user_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Assigned by:</strong>
    <%= course_coordinator.assigned_by_id %>
  </div>
</div>
