<div id="<%= dom_id material %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Course:</strong>
    <%= material.course_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= material.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">File:</strong>
    <%= link_to material.file.filename, material.file, class: "text-gray-700 underline hover:no-underline" if material.file.attached? %>
  </div>
</div>
