<%= form_with model: [course, material], class: "mt-6 space-y-5" do |form| %>
  <% if material.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-red-800" role="alert">
      <p class="font-semibold">No se pudo subir el material.</p>
      <ul class="mt-2 list-disc pl-5">
        <% material.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Título", class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :title, required: true, class: ApplicationHelper::INPUT_CLASSES %>
  </div>

  <div>
    <%= form.label :file, "Archivo", class: "block text-sm font-medium text-slate-700" %>
    <%= form.file_field :file, required: true, accept: MaterialFileFormat::ACCEPT_ATTRIBUTE,
          aria: { describedby: "material_file_help" }, class: "mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2" %>
    <p id="material_file_help" class="mt-2 text-sm text-slate-600">
      Máximo 50 MB por archivo. PDF, Word, Excel, PowerPoint, texto, OpenDocument y documentos de Pages, Numbers o Keynote.
      Para Google Docs, Sheets o Slides, descarga una copia en uno de estos formatos y sube ese archivo.
    </p>
    <% if material.errors.any? %>
      <p class="mt-1 text-sm text-slate-600">Vuelve a seleccionar el archivo antes de enviar.</p>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit "Subir material", class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
    <%= link_to "Volver al curso", course_path(course), class: "text-sm font-medium text-indigo-700 hover:underline" %>
  </div>
<% end %>
