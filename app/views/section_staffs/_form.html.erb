<%= form_with(model: section_staff, class: "contents") do |form| %>
  <% if section_staff.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(section_staff.errors.count, "error") %> prohibited this section_staff from being saved:</h2>

      <ul class="list-disc ml-6">
        <% section_staff.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :section_id %>
    <%= form.text_field :section_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": section_staff.errors[:section_id].none?, "border-red-400 focus:outline-red-600": section_staff.errors[:section_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :user_id %>
    <%= form.text_field :user_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": section_staff.errors[:user_id].none?, "border-red-400 focus:outline-red-600": section_staff.errors[:user_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :role %>
    <%= form.text_field :role, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": section_staff.errors[:role].none?, "border-red-400 focus:outline-red-600": section_staff.errors[:role].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :assigned_by_id %>
    <%= form.text_field :assigned_by_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": section_staff.errors[:assigned_by_id].none?, "border-red-400 focus:outline-red-600": section_staff.errors[:assigned_by_id].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
