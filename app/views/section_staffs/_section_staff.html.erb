<div id="<%= dom_id section_staff %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Section:</strong>
    <%= section_staff.section_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= section_staff.user_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Role:</strong>
    <%= section_staff.role %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Assigned by:</strong>
    <%= section_staff.assigned_by_id %>
  </div>
</div>
