<%= form_with(model: attendance_record, class: "contents") do |form| %>
  <% if attendance_record.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(attendance_record.errors.count, "error") %> prohibited this attendance_record from being saved:</h2>

      <ul class="list-disc ml-6">
        <% attendance_record.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :attendance_session_id %>
    <%= form.text_field :attendance_session_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": attendance_record.errors[:attendance_session_id].none?, "border-red-400 focus:outline-red-600": attendance_record.errors[:attendance_session_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :student_id %>
    <%= form.text_field :student_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": attendance_record.errors[:student_id].none?, "border-red-400 focus:outline-red-600": attendance_record.errors[:student_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :status %>
    <%= form.text_field :status, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": attendance_record.errors[:status].none?, "border-red-400 focus:outline-red-600": attendance_record.errors[:status].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
