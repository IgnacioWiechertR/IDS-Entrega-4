<div id="<%= dom_id attendance_record %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Attendance session:</strong>
    <%= attendance_record.attendance_session_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Student:</strong>
    <%= attendance_record.student_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= attendance_record.status %>
  </div>
</div>
