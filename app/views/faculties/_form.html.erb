<%= form_with(model: faculty, class: "mt-6 space-y-5") do |form| %>
  <% if faculty.errors.any? %>
    <div id="error_explanation" class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <p class="font-medium">No se pudo guardar la facultad:</p>
      <ul class="ml-5 mt-1 list-disc">
        <% faculty.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :name, required: true, placeholder: "Facultad de Ingeniería", class: ApplicationHelper::INPUT_CLASSES %>
  </div>

  <%= form.submit faculty.new_record? ? "Crear facultad" : "Guardar cambios", class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
<% end %>
