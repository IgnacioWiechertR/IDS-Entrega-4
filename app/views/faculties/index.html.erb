<% content_for :title, "Facultades · SGA" %>

<section class="py-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Facultades</h1>
      <p class="mt-1 text-sm text-slate-600">Facultades de <%= current_university.name %>. Cada curso pertenece a una facultad.</p>
    </div>
    <% if can?(:create, Faculty) %>
      <%= link_to "Nueva facultad", new_faculty_path, class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
    <% end %>
  </div>

  <% if @faculties.any? %>
    <div class="mt-6 overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table id="faculties" class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-slate-600">
          <tr>
            <th scope="col" class="px-4 py-2 font-semibold">Nombre</th>
            <th scope="col" class="px-4 py-2 font-semibold">Cursos</th>
            <th scope="col" class="px-4 py-2"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @faculties.each do |faculty| %>
            <tr id="<%= dom_id faculty %>">
              <td class="px-4 py-2 font-medium text-slate-900"><%= faculty.name %></td>
              <td class="px-4 py-2 text-slate-700"><%= @course_counts.fetch(faculty.id, 0) %></td>
              <td class="whitespace-nowrap px-4 py-2 text-right">
                <% if can?(:update, faculty) %>
                  <%= link_to "Editar", edit_faculty_path(faculty), class: "font-medium text-indigo-700 hover:underline" %>
                <% end %>
                <% if can?(:destroy, faculty) %>
                  <%= button_to "Eliminar", faculty, method: :delete, form_class: "ml-3 inline",
                        form: { data: { turbo_confirm: "¿Eliminar la facultad #{faculty.name}?" } },
                        class: "cursor-pointer font-medium text-red-700 hover:underline" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p id="faculties_empty" class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      Todavía no hay facultades. <% if can?(:create, Faculty) %>Crea la primera para poder crear cursos.<% end %>
    </p>
  <% end %>
</section>
