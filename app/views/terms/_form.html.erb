<%= form_with(model: term, class: "mt-6 space-y-5") do |form| %>
  <% if term.errors.any? %>
    <div id="error_explanation" class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
      <p class="font-medium">No se pudo guardar el período:</p>
      <ul class="ml-5 mt-1 list-disc">
        <% term.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :name, required: true, placeholder: "2027-1", class: ApplicationHelper::INPUT_CLASSES %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= form.label :starts_on, class: "block text-sm font-medium text-slate-700" %>
      <%= form.date_field :starts_on, required: true, class: ApplicationHelper::INPUT_CLASSES %>
    </div>
    <div>
      <%= form.label :ends_on, class: "block text-sm font-medium text-slate-700" %>
      <%= form.date_field :ends_on, required: true, class: ApplicationHelper::INPUT_CLASSES %>
    </div>
  </div>

  <div>
    <div class="flex items-center gap-2">
      <%= form.check_box :current, class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %>
      <%= form.label :current, "Es el período vigente", class: "text-sm font-medium text-slate-700" %>
    </div>
    <p class="mt-1 text-sm text-slate-600">Solo hay un período vigente por universidad: al marcar este, el anterior deja de serlo.</p>
  </div>

  <%= form.submit term.new_record? ? "Crear período" : "Guardar cambios", class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
<% end %>
