<%= form_with(model: term, class: "contents") do |form| %>
  <% if term.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(term.errors.count, "error") %> prohibited this term from being saved:</h2>

      <ul class="list-disc ml-6">
        <% term.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :university_id %>
    <%= form.text_field :university_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": term.errors[:university_id].none?, "border-red-400 focus:outline-red-600": term.errors[:university_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": term.errors[:name].none?, "border-red-400 focus:outline-red-600": term.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :starts_on %>
    <%= form.date_field :starts_on, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": term.errors[:starts_on].none?, "border-red-400 focus:outline-red-600": term.errors[:starts_on].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :ends_on %>
    <%= form.date_field :ends_on, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": term.errors[:ends_on].none?, "border-red-400 focus:outline-red-600": term.errors[:ends_on].any?}] %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :current %>
    <%= form.checkbox :current, class: ["block shadow-sm rounded-md border order-first h-5 w-5", {"border-gray-400 focus:outline-blue-600": term.errors[:current].none?, "border-red-400 focus:outline-red-600": term.errors[:current].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
