<% content_for :title, "Períodos · SGA" %>

<section class="py-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Períodos</h1>
      <p class="mt-1 text-sm text-slate-600">Períodos académicos de <%= current_university.name %>. Las secciones de cada curso pertenecen a un período.</p>
    </div>
    <% if can?(:create, Term) %>
      <%= link_to "Nuevo período", new_term_path, class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
    <% end %>
  </div>

  <% if @terms.any? %>
    <div class="mt-6 overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table id="terms" class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-slate-600">
          <tr>
            <th scope="col" class="px-4 py-2 font-semibold">Nombre</th>
            <th scope="col" class="px-4 py-2 font-semibold">Inicio</th>
            <th scope="col" class="px-4 py-2 font-semibold">Fin</th>
            <th scope="col" class="px-4 py-2 font-semibold">Estado</th>
            <th scope="col" class="px-4 py-2 font-semibold">Secciones</th>
            <th scope="col" class="px-4 py-2"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @terms.each do |term| %>
            <tr id="<%= dom_id term %>">
              <td class="px-4 py-2 font-medium text-slate-900"><%= term.name %></td>
              <td class="whitespace-nowrap px-4 py-2 text-slate-700"><%= l(term.starts_on) %></td>
              <td class="whitespace-nowrap px-4 py-2 text-slate-700"><%= l(term.ends_on) %></td>
              <td class="px-4 py-2">
                <% if term.current %>
                  <span class="rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700">Vigente</span>
                <% end %>
              </td>
              <td class="px-4 py-2 text-slate-700"><%= @section_counts.fetch(term.id, 0) %></td>
              <td class="whitespace-nowrap px-4 py-2 text-right">
                <% if can?(:update, term) %>
                  <%= link_to "Editar", edit_term_path(term), class: "font-medium text-indigo-700 hover:underline" %>
                <% end %>
                <% if can?(:destroy, term) %>
                  <%= button_to "Eliminar", term, method: :delete, form_class: "ml-3 inline",
                        form: { data: { turbo_confirm: "¿Eliminar el período #{term.name}?" } },
                        class: "cursor-pointer font-medium text-red-700 hover:underline" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p id="terms_empty" class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      Todavía no hay períodos. <% if can?(:create, Term) %>Crea el primero para poder abrir secciones.<% end %>
    </p>
  <% end %>
</section>
