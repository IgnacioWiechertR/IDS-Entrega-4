<% content_for :title, "Notas de la sección · SGA" %>

<section class="py-8">
  <p class="text-sm">
    <% if can?(:create, Evaluation.new(section: @section)) %>
      <%= link_to "← Evaluaciones de la sección", section_evaluations_path(@section), class: "text-indigo-700 hover:underline" %>
    <% else %>
      <%= link_to "← Sección", course_section_path(@section.course, @section), class: "text-indigo-700 hover:underline" %>
    <% end %>
  </p>

  <p class="mt-2 text-sm font-semibold text-indigo-600">
    <%= @section.course.code %> · Sección <%= @section.number %> · <%= @section.term.name %>
  </p>
  <h1 class="text-2xl font-bold text-slate-900">Notas de <%= @section.course.name %></h1>
  <p class="mt-1 text-sm text-slate-600">
    Preliminar: pendiente de revisión del profesor · Rechazada: el ayudante debe corregirla · Oficial: publicada y visible para el alumno.
  </p>

  <% if @evaluations.empty? %>
    <p id="no-evaluations" class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      Esta sección aún no tiene evaluaciones.
    </p>
  <% elsif @students.empty? %>
    <p id="no-students" class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
      Sección sin matrículas activas.
    </p>
  <% else %>
    <div class="mt-6 overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table id="gradebook" class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-slate-600">
          <tr>
            <th scope="col" class="px-4 py-2 font-semibold">Alumno</th>
            <% @evaluations.each do |evaluation| %>
              <th scope="col" class="px-4 py-2 text-center font-semibold"><%= evaluation.name %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @students.each do |student| %>
            <tr>
              <th scope="row" class="whitespace-nowrap px-4 py-2 text-left font-medium text-slate-900"><%= student.name %></th>
              <% @evaluations.each do |evaluation| %>
                <% grade = @grades[[ student.id, evaluation.id ]] %>
                <td id="cell_<%= student.id %>_<%= evaluation.id %>" class="px-4 py-2 text-center">
                  <% if grade %>
                    <span class="font-semibold"><%= grade_score(grade) %></span>
                    <span class="ml-1 rounded px-1.5 py-0.5 text-xs <%= gradebook_state_classes(grade) %>"><%= gradebook_state_label(grade) %></span>
                  <% else %>
                    <span class="text-slate-400">—</span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
