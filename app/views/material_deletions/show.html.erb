<% content_for :title, "Confirmar eliminación · #{@course.code} · SGA" %>

<section class="mx-auto max-w-2xl py-8">
  <p class="text-sm text-indigo-700"><%= @course.university.name %> · <%= @course.code %></p>
  <h1 class="mt-2 text-2xl font-bold text-slate-900">¿Eliminar este material?</h1>
  <p class="mt-2 text-slate-600"><%= @course.name %></p>
  <div class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
    <p id="material_deletion_title" class="break-words font-semibold text-slate-900"><%= @material.title %></p>
    <p class="mt-2 break-words text-sm text-slate-600">Archivo: <%= @material.file.attached? ? @material.file.filename : "Sin archivo adjunto" %></p>
  </div>
  <p class="mt-4 rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
    Se eliminará este material y se retirará el acceso a su archivo. Esta acción no se puede deshacer.
  </p>
  <div class="mt-6 flex flex-wrap items-center gap-3">
    <%= button_to "Eliminar definitivamente", course_material_deletion_path(@course, @material), method: :delete,
          params: { confirmation: "eliminar" }, class: "rounded-md bg-red-600 px-4 py-2 font-semibold text-white hover:bg-red-500" %>
    <%= link_to "Cancelar", course_material_deletions_path(@course), class: "text-sm font-medium text-indigo-700 hover:underline" %>
  </div>
</section>
