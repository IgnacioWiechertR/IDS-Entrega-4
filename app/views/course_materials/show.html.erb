<% content_for :title, "#{material_display_title(@material)} · #{@course.code} · SGA" %>

<section class="py-8">
  <%= link_to "← Volver al material del curso", course_materials_path(@course), class: "text-sm font-medium text-indigo-700 hover:underline" %>
  <p class="mt-4 text-sm text-indigo-700"><%= @course.university.name %> · <%= @course.code %> · <%= @course.name %></p>
  <h1 class="mt-2 break-words text-2xl font-bold text-slate-900"><%= material_display_title(@material) %></h1>

  <dl id="material_details" class="mt-5 grid gap-4 rounded-lg border border-slate-200 bg-white p-5 sm:grid-cols-3">
    <div>
      <dt class="text-sm font-medium text-slate-500">Archivo</dt>
      <dd class="break-words text-slate-900"><%= @material.file.attached? ? @material.file.filename : "Archivo no disponible" %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-slate-500">Tamaño</dt>
      <dd class="text-slate-900"><%= @material.file.attached? ? number_to_human_size(@material.file.byte_size) : "—" %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-slate-500">Fecha de publicación</dt>
      <dd class="text-slate-900"><%= l(@material.created_at, format: :short) %></dd>
    </div>
  </dl>

  <h2 class="mt-8 text-lg font-semibold text-slate-900">Vista previa</h2>
  <% if @preview.available? %>
    <p class="mt-2"><%= link_to "Abrir vista previa en otra pestaña", preview_course_material_path(@course, @material),
          target: "_blank", rel: "noopener", data: { turbo: false }, class: "text-sm font-medium text-indigo-700 hover:underline" %></p>
    <iframe id="material_preview" src="<%= preview_course_material_path(@course, @material) %>" title="Vista previa de <%= material_display_title(@material) %>"
            loading="lazy" class="mt-3 h-[70vh] w-full rounded-lg border border-slate-200 bg-white"></iframe>
  <% else %>
    <p id="preview_unavailable" class="mt-3 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-slate-600">
      La vista previa no está disponible para este archivo.
      Se pueden visualizar archivos PDF y de texto.
    </p>
  <% end %>
</section>
