<section aria-labelledby="materials_heading" class="mt-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 id="materials_heading" class="text-lg font-semibold text-slate-900">Material académico</h2>
    <%= link_to "Ver todo el material", course_materials_path(course), class: "text-sm font-medium text-indigo-700 hover:underline" %>
  </div>
  <% if materials.any? %>
    <ul id="materials" class="mt-3 divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white">
      <% materials.each do |material| %>
        <li id="<%= dom_id(material) %>" class="px-4 py-3 text-sm">
          <%= link_to material_display_title(material), course_material_path(course, material), class: "font-medium text-indigo-700 hover:underline" %>
          <% if material.file.attached? %>
            <p class="mt-1 break-words text-slate-600"><%= material.file.filename %> · <%= number_to_human_size(material.file.byte_size) %></p>
          <% else %>
            <p class="mt-1 text-slate-500">Archivo no disponible.</p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p id="materials_empty" class="mt-3 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">Este curso aún no tiene material.</p>
  <% end %>
</section>
