<% content_for :title, "Syllabus · #{@course.code} · SGA" %>

<section class="py-8">
  <%= link_to "← Volver al curso", course_path(@course, term_id: @term.id), class: "text-sm font-medium text-indigo-700 hover:underline" %>
  <p class="mt-4 text-sm text-indigo-700"><%= @course.university.name %> · <%= @course.code %> · <%= term_period(@term) %></p>

  <div class="mt-2 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Syllabus · <%= @course.name %></h1>
      <p class="mt-1 text-sm text-slate-600">
        <%= @syllabus.file.filename %> · <%= number_to_human_size(@syllabus.file.byte_size) %> ·
        actualizado el <%= l(@syllabus.updated_at.to_date) %><% if @syllabus.uploaded_by %> por <%= @syllabus.uploaded_by.name %><% end %>
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <%= link_to "Descargar", download_course_syllabus_path(@course, term_id: @term.id),
            download: true, data: { turbo: false }, class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
      <%= link_to "Abrir en otra pestaña", preview_course_syllabus_path(@course, term_id: @term.id),
            target: "_blank", rel: "noopener", data: { turbo: false },
            class: "rounded-md border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50" %>
      <% if can?(:upload, @syllabus) %>
        <%= link_to "Reemplazar syllabus", new_course_syllabus_path(@course, term_id: @term.id),
              class: "rounded-md border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50" %>
      <% end %>
    </div>
  </div>
  <% if @syllabus.locked? && can?(:upload, Syllabus.new(course: @course, term: @term, university: @course.university)) %>
    <p id="syllabus_locked" class="mt-3 rounded-md border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
      El período <%= @term.name %> ya comenzó, así que este syllabus no se puede reemplazar.
    </p>
  <% end %>

  <iframe id="syllabus_preview" src="<%= preview_course_syllabus_path(@course, term_id: @term.id) %>"
          title="Syllabus de <%= @course.name %>" class="mt-6 h-[80vh] w-full rounded-lg border border-slate-200 bg-white"></iframe>
</section>
