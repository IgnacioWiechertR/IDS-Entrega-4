<%# The syllabus of the course in one term, on the course overview and on each section. %>
<% syllabus = course.syllabi.with_attached_file.includes(:uploaded_by).find_by(term: term) %>
<% blank_syllabus = Syllabus.new(course: course, term: term, university: course.university) %>
<% uploadable = syllabus || blank_syllabus %>
<div id="syllabus" class="mt-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-slate-200 bg-white p-5">
  <div>
    <h2 class="text-lg font-semibold text-slate-900">Syllabus</h2>
    <% if syllabus&.file&.attached? %>
      <p class="mt-1 text-sm text-slate-600">
        <%= syllabus.file.filename %> · actualizado el <%= l(syllabus.updated_at.to_date) %>
        <% if syllabus.uploaded_by %>por <%= syllabus.uploaded_by.name %><% end %>
      </p>
      <% if syllabus.locked? && can?(:upload, blank_syllabus) %>
        <p class="mt-1 text-sm text-amber-700">El período ya comenzó: el syllabus queda fijo hasta el próximo período.</p>
      <% end %>
    <% else %>
      <p class="mt-1 text-sm text-slate-600">Este curso todavía no tiene syllabus para <%= term.name %>.</p>
    <% end %>
  </div>
  <div class="flex flex-wrap items-center gap-2 text-sm">
    <% if syllabus&.file&.attached? %>
      <%= link_to "Ver syllabus", course_syllabus_path(course, term_id: term.id), class: ApplicationHelper::PRIMARY_BUTTON_CLASSES %>
      <%= link_to "Descargar", download_course_syllabus_path(course, term_id: term.id), download: true, data: { turbo: false },
            class: "rounded-md border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50" %>
    <% end %>
    <% if can?(:upload, uploadable) %>
      <%= link_to (syllabus ? "Reemplazar syllabus" : "Subir syllabus"), new_course_syllabus_path(course, term_id: term.id),
            class: "rounded-md border border-slate-300 px-4 py-2 font-semibold text-slate-700 hover:bg-slate-50" %>
    <% end %>
  </div>
</div>
